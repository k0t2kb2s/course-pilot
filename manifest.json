{
  "manifest_version": 3,
  "name": "CoursePilot",
  "description": "Autopilot for Coursera: solves quizzes, fills assignments, runs peer reviews, and exports clean tasks.",
  "version": "0.2.0",
  "action": {
    "default_title": "CoursePilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "sidePanel", "tabs"],
  "host_permissions": ["<all_urls>", "https://api.deepseek.com/*"]
}
